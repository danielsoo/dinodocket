# Luminal Cloud (OpenAI-compatible). Get a key at https://dash.luminal.com/
# Without these, the Agent Lab runs mock agents and the chat uses a rule-based parser.
LUMINAL_API_KEY=
LUMINAL_BASE_URL=        # the OpenAI-compatible base URL shown in your Luminal dashboard (ends before /chat/completions)
LUMINAL_MODEL=           # e.g. the DeepSeek or GLM flash model id from the dashboard

# Optional: MongoDB Atlas, stores every Agent Lab run
MONGODB_URI=
MONGODB_DB=chief
